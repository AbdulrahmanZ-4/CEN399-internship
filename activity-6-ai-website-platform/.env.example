# --- Contact form email settings ---------------------------------------------
# Copy this file to ".env" and fill in the real values.
# Never commit the real .env file.

# The Gmail account that SENDS the email (the mailbox nodemailer logs into).
GMAIL_USER=your.sending.account@gmail.com

# A Gmail "App Password" (16 characters, NOT your normal password).
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for the account.)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO=where.enquiries.should.arrive@example.com

# Ports (optional; defaults shown).
HTTPS_PORT=3000
HTTP_PORT=3001

# --- AI chatbot service (chatbot/api.py) -------------------------------------
# Where the local Python RAG service listens. server.js proxies /api/chat to it.
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8000

# --- Admin dashboard (admin.html) --------------------------------------------
# Required. There are no defaults: the server exits at start-up
# if either of these is missing.
ADMIN_USER=choose-a-username
ADMIN_PASS=choose-a-long-random-password
